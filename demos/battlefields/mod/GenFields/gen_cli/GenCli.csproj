<Project Sdk="Microsoft.NET.Sdk">
  <!-- The battlefield generator of the GenFields mod as a command-line program: the same source files (../src/gen),
       no game needed. For timing and for checking its output with the Python tools.
       dotnet build -c Release -o <output folder>;  GenCli.exe <data folder> <out folder> <scene name> [key=value ...] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GenCli</AssemblyName>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="Program.cs" />
    <Compile Include="..\src\gen\*.cs" />
  </ItemGroup>
</Project>
